# Python
.venv/
__pycache__/
*.pyc
*.log.bak

# Secrets (never commit real keys)
.env

# Raw JSONL is regenerable via scripts/prepare_data.py (keep packed .bin)
data/*/raw/

# Checkpoint optimizer states exceed GitHub LFS free quota (~1 GB):
# full resume state stays local; pushed checkpoints carry model + trainer state.
optimizer.pt

# Smoke drill checkpoints (disposable; smoke/final is tracked)
runs/smoke/checkpoint-*/

# Pilot checkpoints other than the handoff resume point
runs/pilot/checkpoint-*
!runs/pilot/checkpoint-1000/
runs/pilot/checkpoint-1500/
runs/pilot/checkpoint-2000/
runs/pilot/checkpoint-2500/
runs/pilot/checkpoint-3000/

# Target run (M3): weights stay local by decision — the ~900 MB M3 model does
# not fit free LFS (~790 MB of 1 GB used). Metrics, logs, and small final-dir
# files stay tracked.
runs/target/checkpoint-*/
runs/target/final/model.safetensors
runs/target/*.log

# SFT run (C12 Tier 1): weights stay LOCAL — same LFS decision as M3 (~906 MB
# fp32 model does not fit the free LFS quota). Summaries, reports, tokenizer
# files and tfevents stay tracked. Covers the archived pilot dir too (sft_t1_pilot).
runs/sft_t1*/checkpoint-*/
runs/sft_t1*/final/model.safetensors
runs/sft_t1*/*.log

# C12 Tier 2 teacher (Qwen3.5-0.8B judge, ~1.8 GB): local-only like the ladder
# weights (LFS quota) - never commit data/teacher/.
data/teacher/

# Machine-move checkpoint zips the user stages here between machines (2.7 GB
# archives; weights stay local per the LFS decision, HANDOFF section 7)
checkpoint_backup/

# Milestone B A/B arms (8-bit Adam study): weights stay local - same LFS
# decision as target/sft (384 MB fp32 per ckpt x4 would blow the ~1 GB quota).
# Metrics, logs, trainer_state and tfevents stay tracked. optimizer.pt is
# globally ignored above.
runs/pilot-ab-base/checkpoint-*/
runs/pilot-ab-base/final/model.safetensors
runs/pilot-b8/checkpoint-*/
runs/pilot-b8/final/model.safetensors
runs/pilot-b8-r2x16/checkpoint-*/
runs/pilot-b8-r2x16/final/model.safetensors

# Web UI transient launch state (pid etc.) - never meaningful in git
webui/job_state.json
