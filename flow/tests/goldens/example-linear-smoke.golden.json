{
  "data": {
    "dataset_candidates": [
      {
        "name": "RowTour-360"
      }
    ],
    "dedupe": true,
    "min_chars": 40,
    "raw_dir": "data/example-linear-smoke/raw",
    "rows": 480000,
    "shard_tokens": 8000000,
    "tokens_dir": "data/example-linear-smoke/tokens",
    "val_fraction": 0.05
  },
  "eval": {
    "max_new_tokens": 64,
    "prompts": [
      "def fibonacci(n):",
      "class Stack:"
    ]
  },
  "model": {
    "ctx": 512,
    "dropout": 0.0,
    "ffn": 1024,
    "heads": 4,
    "hidden": 256,
    "kv_heads": 2,
    "layers": 4,
    "tie_embeddings": true
  },
  "name": "example-linear-smoke",
  "tokenizer": {
    "name": "codellama/CodeLlama-7b-hf",
    "vocab_size": 32000
  },
  "train": {
    "accum": 32,
    "batch": 1,
    "dataloader_num_workers": 0,
    "eval_batch": 4,
    "eval_steps": 500,
    "final_dir": "runs/example-linear-smoke/final",
    "fp16": true,
    "grad_ckpt": true,
    "logging_steps": 50,
    "lr": 0.0004,
    "max_grad_norm": 1.0,
    "max_steps": 200,
    "optim": "adamw_torch",
    "output_dir": "runs/example-linear-smoke",
    "save_steps": 500,
    "save_total_limit": 3,
    "scheduler": "cosine",
    "seed": 42,
    "warmup_steps": 10,
    "weight_decay": 0.1
  }
}
